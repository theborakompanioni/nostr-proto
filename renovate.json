{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "postUpgradeTasks": {
    "commands": [
      "./gradlew -Dorg.gradle.caching=false -Dorg.gradle.configureondemand=false -Dorg.gradle.parallel=false dependencies dependencyTree --write-locks"
    ],
    "fileFilters": [
      "buildscript-gradle.lockfile",
      "gradle/verification-metadata.xml",
      "gradle/verification-keyring.gpg",
      "gradle/verification-keyring.keys",
      "**/*.lockfile"
    ],
    "installTools": {
      "java": {}
    }
  }
}
